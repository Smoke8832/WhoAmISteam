; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Who Am I? Party"
config/description="The living-room guessing game, online. Stick a name on your friend's forehead and ask yes/no questions until you know who you are."
config/version="0.1.0"
run/main_scene="res://src/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

Settings="*res://src/autoload/Settings.gd"
Locale="*res://src/autoload/Locale.gd"
Audio="*res://src/autoload/Audio.gd"
SteamService="*res://src/autoload/SteamService.gd"
Net="*res://src/autoload/Net.gd"
Game="*res://src/autoload/Game.gd"
RoundManager="*res://src/round/RoundManager.gd"
Voice="*res://src/autoload/Voice.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/custom_font="res://assets/fonts/Nunito-Variable.ttf"

